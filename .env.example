# Project Hub API base URL (no trailing slash)
VITE_API_BASE_URL=http://127.0.0.1:8000

# "local" talks to an API running with AUTH_MODE=local (no sign-in).
# "cognito" requires sign-in through the Cognito hosted login page; run the API with AUTH_MODE=cognito.
VITE_AUTH_MODE=local

# Cognito hosted login (used when VITE_AUTH_MODE=cognito). The client must be a PUBLIC
# app client (no secret) with http(s)://<origin>/auth/callback as a callback URL.
VITE_COGNITO_DOMAIN=https://ca-central-1aiodflx4w.auth.ca-central-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=1d5p4u5h0td19qbg5u5l556s8c
# Optional overrides (default to the current origin)
# VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
# VITE_COGNITO_LOGOUT_URI=http://localhost:5173/
