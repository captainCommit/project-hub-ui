# Leave empty to call the API on the same origin (/api/...). Required for cookie sessions:
# the session cookie is SameSite=Strict, so the UI and API must be served from the same site.
VITE_API_BASE_URL=
# Dev server only: where `npm run dev` proxies /api requests.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# "local" talks to an API running with AUTH_MODE=local (no sign-in).
# "cognito" requires sign-in through the Cognito hosted login page; run the API with AUTH_MODE=cognito.
VITE_AUTH_MODE=local

# Cognito hosted login (used when VITE_AUTH_MODE=cognito). The API holds the client secret and
# exchanges the code; the browser only needs the public domain and client id.
VITE_COGNITO_DOMAIN=https://projecthub-auth.auth.ca-central-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=5cfgg1smmi3h7bhmv19tu6hom0
# Optional overrides (default to the current origin)
# VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
# VITE_COGNITO_LOGOUT_URI=http://localhost:5173/
