{
  "name": "Sprint",
  "type": "object",
  "properties": {
    "sprint_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "duration_weeks": {
      "type": "number",
      "default": 2
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "active",
        "completed"
      ],
      "default": "planning"
    }
  },
  "required": [
    "name",
    "project_id"
  ]
}