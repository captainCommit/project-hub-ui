{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "ticket_number": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "general",
        "technical",
        "billing",
        "bug",
        "feature_request",
        "account"
      ],
      "default": "general"
    },
    "subject": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "requester_name": {
      "type": "string"
    },
    "requester_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "awaiting_response",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "open"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "support"
            ]
          },
          "author": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "category",
    "description",
    "requester_name",
    "requester_email"
  ]
}